{
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext"],
    "types": ["node"],
    
    // Altera o rootDir para a raiz para englobar a pasta prisma
    "rootDir": ".",
    "outDir": "./dist",

    // Configurações de Saída e Qualidade
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": false,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*", "prisma/**/*"]
}